{
  "name": "tsrp-federal-government",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && node --check scripts/register-discord-command.mjs",
    "db:create": "wrangler d1 create tsrp-goverment-db",
    "db:migrate:local": "wrangler d1 migrations apply tsrp-goverment-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tsrp-goverment-db --remote",
    "discord:register": "node scripts/register-discord-command.mjs"
  },
  "devDependencies": { "wrangler": "^4.45.0" }
}
