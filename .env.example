# Existing GitHub Actions vacancy-sync secrets (unchanged)
DISCORD_TOKEN=your_vacancy_bot_token
GUILD_ID=your_discord_server_id

# Cloudflare Worker secrets: add with wrangler secret put NAME
GROQ_API_KEY=your_groq_api_key
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_PUBLIC_KEY=your_discord_application_public_key

# Local-only variable for scripts/register-discord-command.mjs; do not upload to Cloudflare
DISCORD_BOT_TOKEN=your_discord_ai_bot_token

# Non-secret Worker variables
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_GUILD_ID=your_tsrp_discord_server_id
DISCORD_REDIRECT_URI=https://YOUR-WORKER.workers.dev/auth/discord/callback
WEB_POST_LOGIN_URL=https://YOUR-WORKER.workers.dev/
AI_MODEL=llama-3.3-70b-versatile
