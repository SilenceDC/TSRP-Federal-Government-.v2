{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsrp-federal-government--v2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/discord/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsrp-goverment-db",
      "database_id": "051e83fe-a844-4528-968f-8df28d45da8b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "DISCORD_CLIENT_ID": "1568333697021776055",
    "DISCORD_REDIRECT_URI": "https://tsrp-federal-government--v2.tsrp-community.workers.dev/auth/discord/callback",
    "WEB_POST_LOGIN_URL": "https://tsrp-federal-government--v2.tsrp-community.workers.dev/"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "vars": {
      "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
      "DISCORD_CLIENT_ID": "preview-disabled",
      "DISCORD_REDIRECT_URI": "https://example.invalid/auth/discord/callback",
      "WEB_POST_LOGIN_URL": "https://example.invalid/"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "tsrp-preview-db",
        "database_id": "cb6de416-a41d-4f9c-854d-a008e2cd75cd",
        "migrations_dir": "migrations"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  }
}
